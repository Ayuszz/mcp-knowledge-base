# Nothing here is required — the server runs with zero configuration,
# storing notes in ./data/notes.json and running without a cache.
# Set these to opt into the upgrade paths (see docker-compose.yml):

# Redis connection string. If unset, caching silently disables itself
# (see src/cache.js) — the server still works, just without the speed-up.
REDIS_URL=redis://localhost:6379

# Overrides where notes are stored (defaults to ./data/notes.json).
# KB_DATA_FILE=./data/notes.json

# Only used if you swap store.js for the pgvector implementation described
# in the README's "Scaling this up" section.
# DATABASE_URL=postgres://kb:kb_dev_password@localhost:5432/knowledge_base
