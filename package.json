{
  "name": "mcp-knowledge-base",
  "version": "1.0.0",
  "description": "A local-first MCP server exposing a personal knowledge base to any MCP client (Claude Desktop, Cursor, etc.), with real semantic search — no API keys, no cloud services required to run.",
  "type": "module",
  "main": "src/server.js",
  "license": "ISC",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-timeout=45000 test/*.test.js",
    "test:unit": "node --test --test-timeout=30000 test/embeddings.test.js test/store.test.js test/cache.test.js",
    "test:e2e": "node --test --test-timeout=45000 test/e2e.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xenova/transformers": "^2.17.2",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  }
}
