# Nothing here is required to run the LOCAL stdio server (`npm start`) —
# it stores notes in ./data/notes.json and runs without a cache by default.

# Redis connection string. If unset, caching silently disables itself
# (see src/cache.js) — the server still works, just without the speed-up.
REDIS_URL=redis://localhost:6379

# Overrides where notes are stored locally (defaults to ./data/notes.json).
# KB_DATA_FILE=./data/notes.json

# REQUIRED for the Vercel/HTTP deployment (api/mcp.js) — NOT needed to run
# the local stdio server. A Supabase/Postgres connection string; see the
# README's "Deploying to Vercel" section for how to get this value.
# Set this in Vercel's dashboard for the real deployment, not in a committed
# file. It's listed here only so every variable the project reads is documented.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
